{
  "expo": {
    "name": "One More", // 사용자 제공 재료 기반 레시피 추천 프로젝트 명칭
    "slug": "one_more_app", // Expo 내부 대시보드 및 프로젝트 URL 식별자
    "version": "1.0.0", // 애플리케이션 배포 버전 번호
    "orientation": "portrait", // 화면 방향을 세로 모드로 고정
    "icon": "./assets/images/refrigerator_character.png", // iOS 및 범용 기기에서 사용하는 기본 아이콘 경로
    "scheme": "onemoreapp", // 외부 앱이나 웹에서 본 앱으로 연결하는 딥링크 스킴
    "userInterfaceStyle": "automatic", // 시스템 설정에 따라 라이트/다크 모드 자동 전환
    "newArchEnabled": true, // 리액트 네이티브 New Architecture 활성화 여부

    "ios": {
      "supportsTablet": true, // 태블릿 기기 지원 여부
      "bundleIdentifier": "com.firstproject.onemore" // iOS 마켓 배포용 고유 식별 주소
    },

    "android": {
      "package": "com.firstproject.onemore", // 안드로이드 마켓 배포용 고유 패키지 주소
      "versionCode": 1, // 앱 업데이트 시마다 증가시켜야 하는 정수 형태의 버전 코드
      "adaptiveIcon": {
        "backgroundColor": "#ffffff", // 안드로이드 적응형 아이콘의 배경색 설정
        "foregroundImage": "./assets/images/refrigerator_character_removebg.png" // 안드로이드 적응형 아이콘의 전경 이미지 경로
      },
      // 인터넷 통신 및 카메라, 외부 저장소 접근 권한 명시
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true, // 안드로이드 하단 내비게이션 바까지 화면을 확장하는 설정
      "predictiveBackGestureEnabled": false // 안드로이드 시스템 뒤로가기 제스처 예측 활성화 여부
    },

    "web": {
      "output": "static", // 웹 빌드 시 정적 파일 출력 설정
      "favicon": "./assets/images/refrigerator_character.png" // 웹 브라우저 탭에 표시되는 아이콘 경로
    },

    "plugins": [
      "expo-router", // 파일 시스템 기반 라우팅 플러그인 사용
      [
        "expo-splash-screen", // 앱 실행 시 로딩 화면 제어 플러그인
        {
          "image": "./assets/images/refrigerator_character_removebg.png", // 스플래시 화면 이미지 경로
          "imageWidth": 200, // 스플래시 이미지의 가비지 너비 설정
          "resizeMode": "contain", // 화면 크기에 따른 이미지 비율 유지 방식
          "backgroundColor": "#ffffff", // 스플래시 화면의 배경색
          "dark": {
            "backgroundColor": "#000000" // 다크 모드 시 스플래시 배경색
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true, // 라우팅 시 타입 안정성 제공 설정
      "reactCompiler": true // 빌드 성능 최적화를 위한 리액트 컴파일러 사용 여부
    },

    "extra": {
      "router": {}, // 라우터 관련 추가 설정 데이터
      "eas": {
        "projectId": "2ca1547d-b544-4068-b349-67df22342f1a" // EAS 빌드 및 배포를 위한 프로젝트 고유 아이디
      }
    },

    "owner": "leeseungeun" // 프로젝트 소유자 계정 이름
  }
}
